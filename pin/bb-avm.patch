+++ b/barretenberg/cpp/src/barretenberg/vm2/trace_ffi.cpp
@@ -0,0 +1,105 @@
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <functional>
+#include <vector>
+
+#include "barretenberg/vm2/common/avm_io.hpp"
+#include "barretenberg/vm2/generated/columns.hpp"
+#include "barretenberg/vm2/simulation_helper.hpp"
+#include "barretenberg/vm2/tracegen_helper.hpp"
+
+namespace {
+
+using namespace bb::avm2;
+
+/**
+ * @brief Runs `fill` into a byte buffer: on success (0) `*out` holds what it wrote; on failure (1) the error message.
+ * Either way `*out` is malloc'd and the caller frees it.
+ */
+int respond(const std::function<void(std::vector<uint8_t>&)>& fill, uint8_t** out, size_t* out_len)
+{
+    std::vector<uint8_t> buf;
+    int status = 0;
+    try {
+        fill(buf);
+    } catch (const std::exception& e) {
+        buf.assign(e.what(), e.what() + std::strlen(e.what()));
+        status = 1;
+    }
+    *out_len = buf.size();
+    *out = static_cast<uint8_t*>(std::malloc(buf.size() > 0 ? buf.size() : 1));
+    std::memcpy(*out, buf.data(), buf.size());
+    return status;
+}
+
+void put(std::vector<uint8_t>& buf, const void* p, size_t n)
+{
+    const auto* b = static_cast<const uint8_t*>(p);
+    buf.insert(buf.end(), b, b + n);
+}
+
+void put_field(std::vector<uint8_t>& buf, const FF& value)
+{
+    const auto canonical = value.from_montgomery_form();
+    put(buf, canonical.data, 32);
+}
+
+} // namespace
+
+/**
+ * @brief The AVM trace for an FFI prover: simulates the proving inputs' hints and generates the full trace (interactions
+ * included), as AvmAPI::prove does before proving.
+ * @details For every column in `Column` order: a little-endian u32 entry count followed by that many (u32 row, 4
+ * little-endian u64 canonical limbs) non-zero entries.
+ */
+extern "C" __attribute__((visibility("default"))) int bb_avm_trace(const uint8_t* input,
+                                                                   size_t input_len,
+                                                                   uint8_t** out,
+                                                                   size_t* out_len)
+{
+    return respond(
+        [&](std::vector<uint8_t>& buf) {
+            auto inputs = AvmProvingInputs::from(std::vector<uint8_t>(input, input + input_len));
+            auto events = AvmSimulationHelper().simulate_for_witgen(inputs.hints);
+            auto trace = AvmTraceGenHelper().generate_trace(std::move(events), inputs.public_inputs);
+            for (size_t c = 0; c < tracegen::TraceContainer::num_columns(); c++) {
+                const size_t count_at = buf.size();
+                uint32_t count = 0;
+                put(buf, &count, 4);
+                trace.visit_column(static_cast<Column>(c), [&](uint32_t row, const FF& value) {
+                    put(buf, &row, 4);
+                    put_field(buf, value);
+                    count++;
+                });
+                std::memcpy(buf.data() + count_at, &count, 4);
+                trace.clear_column(static_cast<Column>(c));
+            }
+        },
+        out,
+        out_len);
+}
+
+/**
+ * @brief The verifier's public input columns (`PublicInputs::to_columns`) of serialized public inputs, as AvmAPI::verify
+ * reads them: for every column a little-endian u32 length, then its values as 4 little-endian u64 canonical limbs.
+ */
+extern "C" __attribute__((visibility("default"))) int bb_avm_public_inputs(const uint8_t* input,
+                                                                           size_t input_len,
+                                                                           uint8_t** out,
+                                                                           size_t* out_len)
+{
+    return respond(
+        [&](std::vector<uint8_t>& buf) {
+            for (const auto& column : PublicInputs::from(std::vector<uint8_t>(input, input + input_len)).to_columns()) {
+                const auto len = static_cast<uint32_t>(column.size());
+                put(buf, &len, 4);
+                for (const auto& value : column) {
+                    put_field(buf, value);
+                }
+            }
+        },
+        out,
+        out_len);
+}
