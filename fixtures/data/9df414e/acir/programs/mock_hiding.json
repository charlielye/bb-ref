    "51": {
      "source": "use mock_types::{\n    KernelPublicInputs, MEGA_KERNEL_VK_LENGTH_IN_FIELDS, PROOF_TYPE_HN_FINAL, VerificationKey,\n};\n\nfn main(\n    prev_kernel_public_inputs: call_data(0) KernelPublicInputs,\n    kernel_vk: VerificationKey<MEGA_KERNEL_VK_LENGTH_IN_FIELDS>,\n) -> pub KernelPublicInputs {\n    std::verify_proof_with_type(kernel_vk.key, [], [], kernel_vk.hash, PROOF_TYPE_HN_FINAL);\n\n    prev_kernel_public_inputs\n}\n",
