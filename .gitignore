/target
# Fixture instance dumps (tools/regen/regen_*.sh) run to gigabytes and stay local.
/tests/data/*/instance/*
/tests/data/*/acir/rust_1_1/

# Generated by tools/build_bb_ref_js.sh (ipc-codegen output, its build, and the wasm module).
/js/bb-ref.js/
/js/chonk-bench/node_modules/
/tools/corpus/.built

# Built by pin/build.sh inside the pinned checkout.
/pin/aztec-packages/barretenberg/cpp/build/
/bin/

# Corpus artifacts: regenerated by tools/regen/regen_corpus.sh, not committed.
tools/corpus/node_modules
tools/corpus/*.corpus.zst
# The AVM corpus is a few MB of proving inputs: committed with its goldens.
!tools/corpus/avm-*.corpus.zst
tools/corpus/leaf-assets/
__pycache__/
